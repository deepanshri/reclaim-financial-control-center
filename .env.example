# Frontend: leave empty for local `npm run dev` so the Vite /api proxy
# forwards to http://127.0.0.1:8000 (same-origin cookies).
# Production builds read .env.production:
# VITE_API_BASE_URL=https://reclaim-financial-control-center.onrender.com
VITE_API_BASE_URL=

# Backend (used by FastAPI / python-dotenv)
RECLAIM_ENV=development
RECLAIM_DEMO_MERCHANT_ID=mid_demo_ZC771042
RECLAIM_DEMO_MERCHANT_NAME=Zenzo Commerce
RECLAIM_DEMO_PASSWORD=ReclaimDemo!2026
RECLAIM_SESSION_TTL_SECONDS=28800
RECLAIM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
RECLAIM_COOKIE_SECURE=false
RECLAIM_COOKIE_SAMESITE=lax
RECLAIM_RATE_LIMIT_PER_MINUTE=180
RECLAIM_LOGIN_RATE_LIMIT_PER_MINUTE=20
RECLAIM_ENABLE_DOCS=true
RECLAIM_FINANCE_EMAIL=finance@zenzocommerce.in
RECLAIM_SETTLEMENT_BANK=ICICI Bank Current Account •••• 4412
# Optional override. Default: backend/data/operational.sqlite
# RECLAIM_SQLITE_PATH=
